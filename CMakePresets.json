{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (benchmarks)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug (assertions on)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SPSC_BUILD_BENCHMARKS": "OFF" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (Linux/macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SPSC_SANITIZE": "thread",
        "SPSC_BUILD_BENCHMARKS": "OFF",
        "SPSC_NATIVE": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan (Linux/macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPSC_SANITIZE": "address,undefined",
        "SPSC_BUILD_BENCHMARKS": "OFF",
        "SPSC_NATIVE": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
